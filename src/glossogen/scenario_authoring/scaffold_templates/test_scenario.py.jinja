"""Tests for <<scenario_name>>, using the harness that ships with glossogen.

`glossogen validate <<scenario_name>>` covers the static contract, so it is
not repeated here. What these add is the round loop, which the checker never
starts, and a check that the project's scenario sources load the scenario.

No LLM, no network, and no waiting on a clock: the agents are scripted, so the
harness knows when they have finished rather than guessing.

The scenario is looked up by name rather than imported, so these tests find it
the way `glossogen run` does. Run pytest from the project root.
"""

from pathlib import Path

import pytest

from glossogen.models.event import RoundResultRecorded
from glossogen.testing import (
    assert_no_agent_crashed,
    assert_round_loop_completed,
    assert_scenario_is_loaded,
    run_rounds,
)

SCENARIO = "<<scenario_name>>"
PRESET = "knobs_default"


def test_the_scenario_sources_load_this_scenario() -> None:
    """The scan of the project directory, or the configured sources, reach this folder."""
    assert_scenario_is_loaded(scenario_name=SCENARIO)


@pytest.mark.asyncio
async def test_the_round_loop_runs(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    """Every round reaches a recorded verdict, and no agent dies on the way."""
    result = await run_rounds(
        scenario_name=SCENARIO,
        preset_name=PRESET,
        round_count=2,
        overrides={},
        tmp_path=tmp_path,
        monkeypatch=monkeypatch,
    )

    assert_round_loop_completed(result=result, round_count=2)
    assert_no_agent_crashed(result=result)


@pytest.mark.asyncio
async def test_relaying_the_code_word_wins_the_round(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """The scoring rule, driven end to end rather than called directly.

    This is the test to rewrite first: it asserts what your scenario is *for*.
    The scripted agents above only chat, so the word is never relayed and the
    round fails. Script the relay to send the round's word and it passes.
    """
    result = await run_rounds(
        scenario_name=SCENARIO,
        preset_name=PRESET,
        round_count=1,
        overrides={},
        tmp_path=tmp_path,
        monkeypatch=monkeypatch,
    )

    verdicts = result.of_type(event_type=RoundResultRecorded)
    assert len(verdicts) == 1
    assert verdicts[0].success is False
