"""<<scenario_name>>: get one code word across a metered link, per round.

The whole scenario in one module: its ids, knobs, event, team structure, world,
and the scenario class glossogen loads. `@scenario(name="<<scenario_name>>")`
registers the class when glossogen imports this file, which it does because
`[tool.glossogen] scenarios` in `pyproject.toml` names this folder. Split it into
several modules whenever it grows; glossogen only needs the decorated class.

Prompts and presets live beside this file: `prompts/` and `knobs_*.json`.

Deterministic on purpose: a round succeeds when the relay sends the round's code
word, which the world observes directly, so no LLM judges it. Scenarios that need
a judgement call build an LLM judge instead and call it from
`judge_round_result`.
"""

import random
from pathlib import Path
from typing import Any, Literal

from pydantic import Field

from glossogen.engine import team_structure
from glossogen.engine.round_world import RoundWorld
from glossogen.engine.team_declaration import NoDebrief, RoleSpec, TaskChannel, TeamSpec
from glossogen.models.agent_config import AgentConfig, AgentRole
from glossogen.models.channel import Channel, ChannelTemplateEntry
from glossogen.models.event_base import EventBase
from glossogen.runtime.scenario_tool import ScenarioTool
from glossogen.runtime.scenario_world import ScenarioWorld
from glossogen.scenario_contract.protocol import SimulationScenario
from glossogen.scenario_contract.registration import scenario
from glossogen.scenario_contract.scenario_base import PrimaryChannel, RoundResult
from glossogen.scenarios.base_knobs import BaseKnobs
from glossogen.template_renderer import TemplateRenderer

PROMPTS_DIR = Path(__file__).parent / "prompts"

BRIEFER_ID = "briefer"
RELAY_ID = "relay"
LINK_CHANNEL_ID = "link"
TEAM_ID = "solo"

BRIEFER_SYSTEM_TEMPLATE = "briefer_system.jinja"
RELAY_SYSTEM_TEMPLATE = "relay_system.jinja"


class <<class_prefix>>Knobs(BaseKnobs):
    """Configuration for <<scenario_name>>.

    Only the fields this scenario adds. `BaseKnobs` already declares round count,
    phase durations, postmortem switches, channel noise and per-agent model
    overrides, and redeclaring one shadows the platform's. Every field is
    required: a preset states the whole configuration, so `knobs_default.json`
    is where the values live.
    """

    seed: int = Field(description="Fixes which code word each round draws.")
    code_words: tuple[str, ...] = Field(
        description="The pool of code words rounds are drawn from."
    )


class <<class_prefix>>RoundOpened(EventBase):
    """Emitted at the start of each round, carrying that round's code word.

    Listed in `event_types()` below. Events written here reach the JSONL, the
    run-detail API and any metric that reads them.
    """

    event_type: Literal["<<scenario_name>>_round_opened"] = "<<scenario_name>>_round_opened"
    code_word: str


def <<scenario_name>>_teams() -> tuple[TeamSpec, ...]:
    """Return the one team this scenario runs.

    One comm link staffed by a briefer who is given the code word and a relay who
    has to send it back. The agent list, the channel and its roster, the display
    names, and which channel is metered are all derived from this. Return more
    than one `TeamSpec` for competing teams.
    """
    return (
        TeamSpec(
            team_id=TEAM_ID,
            task=TaskChannel(
                channel_id=LINK_CHANNEL_ID, name="link", display_name="the link"
            ),
            # `Debrief(...)` opens a post-round channel the agents talk on. This
            # scenario holds none, and says so rather than leaving it unset.
            debrief=NoDebrief(),
            roles=(
                RoleSpec(
                    agent_id=BRIEFER_ID,
                    role_name="Briefer",
                    system_template=BRIEFER_SYSTEM_TEMPLATE,
                    # The tools this role is offered. It is not additive on top
                    # of a default: a role that needs to talk lists `send_message`.
                    tool_names=("send_message",),
                    joins_debrief=False,
                    starts_as_member=True,
                ),
                RoleSpec(
                    agent_id=RELAY_ID,
                    role_name="Relay",
                    system_template=RELAY_SYSTEM_TEMPLATE,
                    tool_names=("send_message",),
                    joins_debrief=False,
                    starts_as_member=True,
                ),
            ),
        ),
    )


class <<class_prefix>>World(RoundWorld):
    """Meters the link and watches for the relay echoing the round's code word.

    Everything that changes during a round belongs here. `RoundWorld` meters the
    task channel against the round budget; subclass `ScenarioWorld` instead when
    nothing is metered.
    """

    def __init__(self) -> None:
        super().__init__(
            team_specs=<<scenario_name>>_teams(),
            # Notify the agents when they cross a fraction of the round budget,
            # e.g. (0.5, 0.9). Empty means they are never told.
            round_budget_thresholds=(),
            postmortem_channel_ids=frozenset(),
            postmortem_globally_disabled=False,
        )
        self._code_word: str = ""
        self._relayed: bool = False

    def open_round(self, code_word: str) -> None:
        """Start a fresh round on a new code word."""
        self._code_word = code_word
        self._relayed = False
        self.begin_round()

    @property
    def code_word(self) -> str:
        """The word the briefer has to get across this round."""
        return self._code_word

    @property
    def relayed(self) -> bool:
        """Whether the relay has echoed this round's code word."""
        return self._relayed

    def on_message(self, agent_id: str, channel_id: str, text: str, token_count: int) -> None:
        """Charge the message, then check whether the relay just echoed the word.

        Call `super()` first: that is what meters the message against the round
        budget. An override that forgets it makes the budget unenforceable.
        """
        super().on_message(
            agent_id=agent_id, channel_id=channel_id, text=text, token_count=token_count
        )
        if agent_id != RELAY_ID or channel_id != LINK_CHANNEL_ID:
            return
        if self._code_word and self._code_word.lower() in text.lower():
            self._relayed = True


@scenario(name="<<scenario_name>>")
class <<class_prefix>>Scenario(SimulationScenario):
    """Two agents, one link, one code word a round."""

    def __init__(self, knobs: <<class_prefix>>Knobs) -> None:
        self._knobs = knobs
        self._renderer = TemplateRenderer(prompts_dirs=[PROMPTS_DIR])
        self._team_specs = <<scenario_name>>_teams()
        self._world = <<class_prefix>>World()
        # Shuffled once and taken in order, so rounds get different words and a
        # rerun on the same seed faces the same sequence.
        pool = list(knobs.code_words)
        random.Random(knobs.seed).shuffle(pool)
        self._words_by_round: dict[int, str] = {
            number: pool[(number - 1) % len(pool)]
            for number in range(1, knobs.round_count + 1)
        }

    @classmethod
    def knobs_model(cls) -> type[<<class_prefix>>Knobs]:
        """The knobs model every preset is validated against."""
        return <<class_prefix>>Knobs

    @classmethod
    def event_types(cls) -> tuple[type[EventBase], ...]:
        """Every event class this scenario logs, beyond the platform's own."""
        return (<<class_prefix>>RoundOpened,)

    @classmethod
    def get_agent_roles(cls, knobs: dict[str, Any] | None) -> list[AgentRole]:
        """Name the agents without building them.

        The API calls this before a run exists, to render the per-agent model
        override form, and calls it with `knobs=None` before anything is
        configured. It has to answer either way, and with the same set
        `get_agents` builds.
        """
        _ = knobs
        return [
            AgentRole(agent_id=BRIEFER_ID, role_name="Briefer"),
            AgentRole(agent_id=RELAY_ID, role_name="Relay"),
        ]

    def get_knobs(self) -> <<class_prefix>>Knobs:
        """Return the validated knobs."""
        return self._knobs

    def scenario_description(self) -> str:
        """What the run list and the run-detail page show."""
        return (
            "A briefer is given a code word each round and has to get the relay to send "
            "it back over a metered link."
        )

    def _render_system_prompt(self, role: RoleSpec, channels: list[ChannelTemplateEntry]) -> str:
        """Render one role's prompt over the channels it reaches."""
        return self._renderer.render(
            template_name=role.system_template,
            template_variables={"channels": channels},
        )

    def get_agents(self, default_model: str, default_provider: str) -> list[AgentConfig]:
        """Derive the agents from the declaration."""
        return team_structure.build_agent_configs(
            teams=self._team_specs,
            render_system_prompt=self._render_system_prompt,
            default_model=default_model,
            default_provider=default_provider,
            compaction=self._knobs.compaction,
        )

    def get_channels(self) -> list[Channel]:
        """Derive the channels from the declaration."""
        return team_structure.channels(teams=self._team_specs)

    def get_primary_channels(self) -> list[PrimaryChannel]:
        """The channels every throughput and language metric scores.

        Naming one that does not exist scores an empty transcript, and the metric
        reports a number rather than an error. Two-team scenarios return one
        entry per team, each with its own `team_id`.
        """
        return [
            PrimaryChannel(
                channel_id=LINK_CHANNEL_ID, team_id=None, includes_direct_channels=False
            )
        ]

    def get_world(self) -> ScenarioWorld:
        """Return the live world."""
        return self._world

    def get_tools(self) -> list[ScenarioTool]:
        """Tools beyond the platform's read_notifications / read_channel / send_message.

        None here: sending messages is the whole task. A scenario whose agents
        act on the world returns a `ScenarioTool` per action and lists its name
        in the role's `tool_names`. The executor takes `agent_id` first, which
        the runner fills in for the calling agent; its other parameters, with
        their annotations, are what the model sees:

            async def act(agent_id: str, command: str) -> str:
                if agent_id != RELAY_ID:
                    raise ValueError("Only the relay can act.")
                return self._world.apply(command=command)

            return [ScenarioTool(name="act", description="...", executor=act)]
        """
        return []

    def get_injection(self, round_number: int, agent_id: str) -> str | None:
        """What each agent reads at the start of a round.

        Rendered from `prompts/` in a real scenario. Written inline here only
        because it is two lines; anything longer belongs in a template.
        """
        word = self._words_by_round.get(round_number, "")
        if agent_id == BRIEFER_ID:
            return (
                f"Round {round_number}. Your code word is '{word}'. Get your colleague to "
                "send that exact word on the link."
            )
        return f"Round {round_number}. Wait for the code word, then send it back."

    async def on_round_advanced(self, round_number: int) -> None:
        """Open the round on its word and record it in the log."""
        word = self._words_by_round.get(round_number, "")
        self._world.open_round(code_word=word)
        await self.runtime.event_logger.log(
            event=<<class_prefix>>RoundOpened(round_number=round_number, code_word=word)
        )

    def get_early_round_end_trigger(self) -> str | None:
        """End the round as soon as the word has been relayed.

        Without this the round runs until the agents go idle or the clock runs
        out, which is time nobody learns anything from.
        """
        if self._world.relayed:
            return "code_word_relayed"
        return None

    def judge_round_result(self, round_number: int, trigger: str) -> list[RoundResult]:
        """Score the round. This is what `round_success` reads.

        One `RoundResult` per team. The reason string is shown in the UI and read
        by anyone auditing a run, so it should say what happened, not just
        whether it passed.
        """
        _ = round_number
        _ = trigger
        used = self._world.characters_used(team_id=TEAM_ID)
        if self._world.relayed:
            reason = f"'{self._world.code_word}' relayed in {used} characters"
        else:
            reason = f"'{self._world.code_word}' never relayed ({used} characters spent)"
        return [RoundResult(success=self._world.relayed, team_id=None, reason=reason)]
