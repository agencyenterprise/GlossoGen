[build-system]
requires = ["setuptools>=61"]
build-backend = "setuptools.build_meta"

[project]
name = "<<distribution_name>>"
version = "0.1.0"
requires-python = ">=3.14"
dependencies = [
    # The ref `new-scenario` was given, which defaults to the release matching the
    # version of the glossogen it ran from. An install tracking a branch or a
    # commit reports the version of the release it is ahead of, so if you
    # generated this from one, that default named the release rather than what you
    # are running: change this to your ref, or regenerate with --glossogen-ref.
    # A scenario using a hook added since that release fails to import otherwise.
    "glossogen @ git+https://github.com/agencyenterprise/GlossoGen.git@<<glossogen_ref>>",
]

[project.optional-dependencies]
# `pip install -e ".[testing]"` to run the tests in tests/.
testing = [
    "glossogen[testing] @ git+https://github.com/agencyenterprise/GlossoGen.git@<<glossogen_ref>>",
]

# Where glossogen loads scenarios from, relative to this file: module names,
# .py files or folders. A folder is searched for files that use @scenario.
# Without this table glossogen scans the whole project directory instead;
# `scenarios = []` loads only the scenarios glossogen ships.
[tool.glossogen]
scenarios = ["scenarios"]

# Only needed to build a wheel of this project.
[tool.setuptools.packages.find]
where = ["."]
include = ["scenarios*"]

# Prompts and knob presets are read at runtime, and without this a wheel carries
# only `.py` files and fails at the first template render.
[tool.setuptools.package-data]
scenarios = [
    "**/*.jinja",
    "**/*.json",
]

[tool.pytest.ini_options]
# The harness is async. Without this every async test errors with "async def
# functions are not natively supported".
asyncio_mode = "auto"
# Lets the tests import `scenarios.<<scenario_name>>` from the project root.
pythonpath = ["."]
