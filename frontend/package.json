{
  "name": "glossogen-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "style:check": "stylelint \"src/**/*.{css,scss}\" --max-warnings=0 --allow-empty-input",
    "gen:api-types": "openapi-typescript openapi.json --output src/types/api.gen.ts",
    "prepare": ":"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^9.0.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "^8.5.10"
  }
}
