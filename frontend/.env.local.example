# Frontend configuration, read at request time on the server and forwarded to
# the browser by the root layout. None of these are compiled into the bundle,
# so changing one requires only a restart — not a rebuild.

# Required. Absolute base URL of the backend API.
API_URL=http://localhost:8000

# Auth adapter configuration. Leave unset for single-tenant mode, where every
# request runs as `local-user` in the `local` group.
#
# Every AUTH_PUBLIC_* variable is collected by the server, its prefix stripped,
# and published to the browser — so only values safe in page source belong there.
# An adapter's secrets are read from the environment server-side and are never
# forwarded. See src/features/auth/adapter/README.md.
# AUTH_PUBLIC_PUBLISHABLE_KEY=
#
# The adapter's server-side secrets are read straight from this environment by
# adapter/server.ts and adapter/proxy.ts, under whatever names it expects.
