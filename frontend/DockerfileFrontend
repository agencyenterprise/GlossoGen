FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# The build takes no environment-specific arguments. Configuration is read at
# request time (see src/shared/config/runtime-config.ts), so the resulting
# image is environment-agnostic and can be promoted from staging to production
# unchanged.
FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
# `output: "standalone"` bundles the server but NOT .next/static or public — both
# must be copied in explicitly, or their assets (JS/CSS chunks, /demo/run.json,
# /demo/run.zip) 404 at runtime.
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
USER nextjs
ENV HOSTNAME=0.0.0.0
# Required at runtime: API_URL. Optional: any AUTH_PUBLIC_* values the compiled
# auth adapter needs, plus whatever it reads server-side. None of them means
# single-tenant mode.
CMD ["node", "server.js"]
